 logger = init_logger(__name__)
 
 
+def _sm12x_tag_draft_ub_plan(attn_groups: list[list[AttentionGroup]]) -> int:
+    """r27 L1a: tag this speculator's own FlashInfer draft builders.
+
+    Opt-in with VLLM_SM12X_DRAFT_UB_PLAN=1; a no-op (nothing tagged, nothing
+    logged) otherwise. See `_sm12x_draft_ub_plan_seq_lens` in flashinfer.py.
+    """
+    import os
+
+    if os.environ.get("VLLM_SM12X_DRAFT_UB_PLAN", "0") != "1":
+        return 0
+    tagged = 0
+    for groups in attn_groups:
+        for group in groups:
+            for builder in group.metadata_builders:
+                if type(builder).__name__ == "FlashInferMetadataBuilder":
+                    builder._sm12x_draft_ub_plan = True
+                    tagged += 1
+    if tagged:
+        logger.warning_once(
+            "SM12X draft UB plan ACTIVE: VLLM_SM12X_DRAFT_UB_PLAN=1, %d draft "
+            "FlashInfer builder(s) plan q_len=1 draft decode from "
+            "seq_lens_cpu_upper_bound (no seq_lens D2H)",
+            tagged,
+            scope="process",
+        )
+    else:
+        logger.warning_once(
+            "SM12X draft UB plan INACTIVE: VLLM_SM12X_DRAFT_UB_PLAN=1 but no "
+            "FlashInfer draft builder was found",
+            scope="process",
+        )
+    return tagged
+
+
+def _sm12x_wait_draft_plan(speculator) -> None:
+    """r27 L1a: before re-planning the same FlashInfer draft wrapper, wait until
+    the previous draft plan's host->device staging copies have executed.
+
+    FlashInfer's plan() stages its schedule in a per-wrapper page-locked buffer
+    and copies it with cudaMemcpyAsync (fi070 scheduler.cuh:504); without the
+    seq_lens D2H nothing else orders a second plan after the first copy. This
+    waits on an event recorded right after the previous draft build (not on the
+    end of the stream), so the CPU plans step k+1 while step k's graph runs.
+    """
+    event = speculator._sm12x_draft_plan_event
+    if event is not None and not torch.cuda.is_current_stream_capturing():
+        from vllm.utils.gpu_sync_debug import gpu_sync_allowed
+
+        with gpu_sync_allowed():
+            event.synchronize()
+        speculator._sm12x_draft_plan_event = None
+
+
+def _sm12x_record_draft_plan() -> "torch.cuda.Event | None":
+    if torch.cuda.is_current_stream_capturing():
+        return None
+    event = torch.cuda.Event()
+    event.record()
+    return event
+
