+        def memory_snapshot() -> tuple[int, int, int]:
+            torch.accelerator.synchronize()
+            free_bytes = torch.accelerator.get_memory_info()[0]
+            allocated_bytes = torch.cuda.memory_allocated(self.device)
+            reserved_bytes = torch.cuda.memory_reserved(self.device)
+            return free_bytes, allocated_bytes, reserved_bytes
+
+        def reachable_wrapper_ids(forward_fn: Callable) -> str:
+            """Best-effort IDs for attention wrappers captured by the closure."""
+            wrapper_ids: set[int] = set()
+            seen: set[int] = set()
+
+            def visit(value: Any, depth: int = 0) -> None:
+                if depth > 4 or id(value) in seen:
+                    return
+                seen.add(id(value))
+                if isinstance(value, dict):
+                    for item in value.values():
+                        visit(item, depth + 1)
+                    return
+                if isinstance(value, (list, tuple)):
+                    for item in value:
+                        visit(item, depth + 1)
+                    return
+
+                # Attention metadata objects expose phase records whose
+                # ``wrapper`` field is the graph-bound FlashInfer wrapper.
+                module = type(value).__module__
+                if not module.startswith("vllm.v1.attention"):
+                    return
+                for phase_name in ("prefill", "decode"):
+                    phase = getattr(value, phase_name, None)
+                    wrapper = getattr(phase, "wrapper", None)
+                    if wrapper is not None:
+                        wrapper_ids.add(id(wrapper))
+
+            for cell in forward_fn.__closure__ or ():
+                try:
+                    visit(cell.cell_contents)
+                except ValueError:
+                    # Empty closure cell.
+                    continue
+            return ",".join(hex(x) for x in sorted(wrapper_ids)) or "unreachable"
+
