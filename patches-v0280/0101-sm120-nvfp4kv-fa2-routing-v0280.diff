+@cache
+def _sm12x_nvfp4_linear_writer():
+    """Return the SM12x linear-V-scale NVFP4 store op, or None.
+
+    Provided by the vllm_sm12x_nvfp4kv overlay (patches-nvfp4kv/overlay).
+    Loaded lazily so the module imports on any platform; a missing overlay is
+    logged loudly ONCE because running FA2 NVFP4 with the swizzled writer is a
+    silent-quality failure (long-context recall), not a crash.
+    """
+    import os
+
+    if os.environ.get("VLLM_SM12X_NVFP4_LINEAR_VSF", "1") == "0":
+        logger.warning_once(
+            "VLLM_SM12X_NVFP4_LINEAR_VSF=0: NVFP4 KV stores use the in-tree "
+            "swizzled-V-scale writer (SM100 layout) on SM12x -- expect wrong "
+            "long-context recall; diagnostic mode only."
+        )
+        return None
+    try:
+        from vllm_sm12x_nvfp4kv import reshape_and_cache_nvfp4_linear
+    except Exception as e:  # noqa: BLE001
+        logger.warning_once(
+            "vllm_sm12x_nvfp4kv overlay NOT available (%r): NVFP4 KV stores on "
+            "SM12x fall back to the swizzled-V-scale writer -- long-context "
+            "recall WILL be wrong.",
+            e,
+        )
+        return None
+    logger.info_once("NVFP4KV-SM120: linear-V-scale store overlay ACTIVE")
+    return reshape_and_cache_nvfp4_linear
