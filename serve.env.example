# Settings for scripts/serve.sh. Copy to serve.env (gitignored), set MODEL_DIR, uncomment what you change.
# Environment variables override this file; SERVE_ENV=<file> reads another file. The file is sourced by bash.
# Each commented line shows the default.
MODEL_DIR=                          # required: absolute path of the nvidia/Qwen3.8-27B-NVFP4 download
# CACHE_DIR=$HOME/.cache/qwen38-27b-vllm   # compile caches (torch.compile, Triton, Inductor, FlashInfer), created on first start; honours XDG_CACHE_HOME
# PORT=8020                         # host port of the OpenAI-compatible endpoint
# BIND=127.0.0.1                    # host address the port is published on; 0.0.0.0 exposes it to the network, as the serving host does
# GPUS=0,1                          # two GPU indices, or all
# NAME=qwen38-27b                   # container name; --stop removes this container
# IMAGE=                            # default: the served tag, read from DAILY_IMG in scripts/serve-r231-nvidia-daily.sh
# SERVED_NAME=qwen3.8-27b           # model name clients send
# SERVED_ALIAS=qwen3.6-27b          # further accepted model names, space-separated; empty for none
# KV_TIER_DIR=                      # empty: no KV tier behind the GPU pool; a directory: 16 GiB pinned host-RAM tier plus a disk tier there
# KV_TIER_CAP_GB=300                # disk tier LRU cap: evicts to 80 % once 90 % is used, and keeps 40 GB free on its filesystem
# POWER_LIMIT_W=                    # empty: power limits untouched; 400: sudo nvidia-smi -pl 400 on each card once the boot checks pass
# DOCKER=docker                     # "sudo docker" when the user is not in the docker group
# HEALTH_TIMEOUT=1500               # seconds to wait for /health; a first boot also compiles kernels into CACHE_DIR
