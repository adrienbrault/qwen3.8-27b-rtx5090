@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: Apache-2.0
+
+"""CPU-only tests for LMCache-driven CUDA staging configuration."""
+
+# Third Party
+import pytest
+
+# First Party
+from lmcache.v1.platform.cuda.staging_config import get_gpu_staging_batch_size
+
+
+@pytest.mark.parametrize("value", ["1", "2", "3", "4"])
+def test_accepts_kernel_supported_range(
+    monkeypatch: pytest.MonkeyPatch, value: str
+) -> None:
+    monkeypatch.setenv("LMCACHE_MP_GPU_STAGING_BATCH_SIZE", value)
+    assert get_gpu_staging_batch_size() == int(value)
+
+
+def test_defaults_to_four(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("LMCACHE_MP_GPU_STAGING_BATCH_SIZE", raising=False)
+    assert get_gpu_staging_batch_size() == 4
+
+
+@pytest.mark.parametrize("value", ["0", "5", "not-an-integer"])
+def test_rejects_invalid_values(
+    monkeypatch: pytest.MonkeyPatch, value: str
+) -> None:
+    monkeypatch.setenv("LMCACHE_MP_GPU_STAGING_BATCH_SIZE", value)
+    with pytest.raises(ValueError, match="LMCACHE_MP_GPU_STAGING_BATCH_SIZE"):
+        get_gpu_staging_batch_size()
diff --color -ruN a/tests/v1/test_vllm_kv_cache_group_edits.py b/tests/v1/test_vllm_kv_cache_group_edits.py
--- a/tests/v1/test_vllm_kv_cache_group_edits.py	1970-01-01 01:00:00
+++ b/tests/v1/test_vllm_kv_cache_group_edits.py	2026-08-15 17:48:41
@@ -0,0 +1,202 @@
+# SPDX-License-Identifier: Apache-2.0
+# Standard
+from dataclasses import dataclass
+from unittest.mock import patch
+
+# Third Party
+import pytest
+import torch
+from vllm.v1.kv_cache_interface import KVCacheSpecKind
+
+# First Party
+from lmcache.integration.vllm.kv_cache_group_edits import (
+    apply_kv_cache_group_edits,
+)
+
+
+@dataclass
+class _AttentionSpec:
+    block_size: int
+    page_size_bytes: int
+    compress_ratio: int = 1
+    tq_slot_size: int = 0
+
+
+@dataclass
+class _CacheGroup:
+    layer_names: list[str]
+    kv_cache_spec: _AttentionSpec
+
+
+@dataclass
+class _CacheConfig:
+    kv_cache_groups: list[_CacheGroup]
+    has_mamba_layers: bool = True
+
+
+def test_subpaged_fused_attention_regroups_real_strided_fp8_geometry() -> None:
+    """The rig's dense-NHD/HND-view fp8 pages must regroup without a copy."""
+    logical_block_size = 1616
+    kernel_block_size = 16
+    kernel_pages_per_logical_block = logical_block_size // kernel_block_size
+    num_logical_blocks = 2
+    num_kernel_pages = num_logical_blocks * kernel_pages_per_logical_block
+    num_heads = 4
+    fused_head_size = 512
+
+    # The rig exposed [NB, NH, BS, 2*HS] over dense NHD storage. Its complete
+    # run had NB=15251; two logical blocks retain the exact per-page geometry
+    # and strides without making this CPU regression allocate 500 MB.
+    physical_nhd = (
+        torch.arange(num_kernel_pages, dtype=torch.uint8)
+        .reshape(num_kernel_pages, 1, 1, 1)
+        .expand(
+            num_kernel_pages,
+            kernel_block_size,
+            num_heads,
+            fused_head_size,
+        )
+        .clone()
+    )
+    raw_hnd_view = physical_nhd.permute(0, 2, 1, 3)
+    assert tuple(raw_hnd_view.shape) == (202, 4, 16, 512)
+    assert tuple(raw_hnd_view.stride()) == (32768, 512, 2048, 1)
+    assert not raw_hnd_view.is_contiguous()
+
+    spec = _AttentionSpec(
+        block_size=logical_block_size,
+        page_size_bytes=logical_block_size * num_heads * fused_head_size,
+    )
+    config = _CacheConfig([_CacheGroup(["attention"], spec)])
+
+    layout_hints = {"kv_layout": "HND"}
+    with patch(
+        "lmcache.integration.vllm.kv_cache_group_edits.get_kv_cache_spec_kind",
+        return_value=KVCacheSpecKind.FULL_ATTENTION,
+    ):
+        edited = apply_kv_cache_group_edits(  # type: ignore[arg-type]
+            config, {"attention": raw_hnd_view}, layout_hints
+        )["attention"]
+
+    assert layout_hints["kv_layout"] == "NHD"
+    assert tuple(edited.shape) == (2, 4, 1616, 512)
+    assert tuple(edited.stride()) == (3309568, 512, 2048, 1)
+    assert edited.data_ptr() == raw_hnd_view.data_ptr()
+    expected_nhd = physical_nhd.view(2, 1616, 4, 512)
+    torch.testing.assert_close(edited.permute(0, 2, 1, 3), expected_nhd, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize(
+    ("layout", "dtype"),
+    [
+        pytest.param("NHD", torch.uint8, id="nhd-fp8-bytes"),
+        pytest.param("HND", torch.uint8, id="hnd-fp8-bytes"),
+        pytest.param("NHD", torch.bfloat16, id="nhd-bf16"),
+        pytest.param("HND", torch.bfloat16, id="hnd-bf16"),
+    ],
+)
+def test_subpaged_fused_attention_logical_page_view(
+    layout: str, dtype: torch.dtype
+) -> None:
+    """A logical block ID must round-trip every fused-attention kernel page."""
+    logical_block_size = 6
+    kernel_block_size = 2
+    kernel_pages_per_logical_block = logical_block_size // kernel_block_size
+    num_logical_blocks = 2
+    num_kernel_pages = num_logical_blocks * kernel_pages_per_logical_block
+    num_heads = 3
+    fused_head_size = 4
+
+    if layout == "NHD":
+        kernel_shape = (
+            num_kernel_pages,
+            kernel_block_size,
+            num_heads,
+            fused_head_size,
+        )
+        logical_shape = (
+            num_logical_blocks,
+            logical_block_size,
+            num_heads,
+            fused_head_size,
+        )
+    else:
+        kernel_shape = (
+            num_kernel_pages,
+            num_heads,
+            kernel_block_size,
+            fused_head_size,
+        )
+        logical_shape = (
+            num_logical_blocks,
+            num_heads,
+            logical_block_size,
+            fused_head_size,
+        )
+
+    source = torch.arange(torch.Size(kernel_shape).numel(), dtype=torch.float32)
+    source = source.reshape(kernel_shape).to(dtype)
+    spec = _AttentionSpec(
+        block_size=logical_block_size,
+        page_size_bytes=(
+            logical_block_size * num_heads * fused_head_size * source.element_size()
+        ),
+    )
+    config = _CacheConfig([_CacheGroup(["attention"], spec)])
+
+    with patch(
+        "lmcache.integration.vllm.kv_cache_group_edits.get_kv_cache_spec_kind",
+        return_value=KVCacheSpecKind.FULL_ATTENTION,
+    ):
+        edited_source = apply_kv_cache_group_edits(  # type: ignore[arg-type]
+            config, {"attention": source}, {"kv_layout": layout}
+        )["attention"]
+        destination = torch.zeros_like(source)
+        edited_destination = apply_kv_cache_group_edits(  # type: ignore[arg-type]
+            config, {"attention": destination}, {"kv_layout": layout}
+        )["attention"]
+
+    assert tuple(edited_source.shape) == logical_shape
+    assert edited_source.data_ptr() == source.data_ptr()
+
+    # Regrouping is metadata-only: each logical block covers exactly the
+    # ratio adjacent kernel pages in physical storage order.
+    torch.testing.assert_close(
+        edited_source.reshape(num_logical_blocks, -1),
+        source.reshape(num_logical_blocks, -1),
+        rtol=0,
+        atol=0,
+    )
+    edited_destination[1].copy_(edited_source[1])
+    expected = torch.zeros_like(edited_source)
+    expected[1].copy_(edited_source[1])
+    torch.testing.assert_close(edited_destination, expected, rtol=0, atol=0)
+
+
+def test_scheduler_sized_fused_attention_is_not_edited() -> None:
+    """A backend with no kernel subpaging must keep its native fused view."""
+    logical_block_size = 6
+    num_blocks = 2
+    num_heads = 3
+    fused_head_size = 4
+    source = torch.zeros(
+        (num_blocks, logical_block_size, num_heads, fused_head_size),
+        dtype=torch.bfloat16,
+    )
+    spec = _AttentionSpec(
+        block_size=logical_block_size,
+        page_size_bytes=(
+            logical_block_size * num_heads * fused_head_size * source.element_size()
+        ),
+    )
+    config = _CacheConfig([_CacheGroup(["attention"], spec)])
+
+    with patch(
+        "lmcache.integration.vllm.kv_cache_group_edits.get_kv_cache_spec_kind",
+        return_value=KVCacheSpecKind.FULL_ATTENTION,
+    ):
+        edited = apply_kv_cache_group_edits(  # type: ignore[arg-type]
+            config, {"attention": source}, {"kv_layout": "NHD"}
+        )["attention"]
+
+    assert edited is source
