+# SPDX-License-Identifier: Apache-2.0
+"""Configuration for LMCache-driven CUDA staging buffers."""
+
+# Standard
+import os
+
+GPU_STAGING_BATCH_SIZE_ENV = "LMCACHE_MP_GPU_STAGING_BATCH_SIZE"
+DEFAULT_GPU_STAGING_BATCH_SIZE = 4
+MAX_GPU_STAGING_BATCH_SIZE = 4
+
+
+def get_gpu_staging_batch_size() -> int:
+    """Return the configured number of per-context GPU staging slots."""
+    raw_value = os.getenv(
+        GPU_STAGING_BATCH_SIZE_ENV, str(DEFAULT_GPU_STAGING_BATCH_SIZE)
+    )
+    try:
+        batch_size = int(raw_value)
+    except ValueError as exc:
+        raise ValueError(
+            f"{GPU_STAGING_BATCH_SIZE_ENV} must be an integer from 1 to "
+            f"{MAX_GPU_STAGING_BATCH_SIZE}, got {raw_value!r}"
+        ) from exc
+
+    if not 1 <= batch_size <= MAX_GPU_STAGING_BATCH_SIZE:
+        raise ValueError(
+            f"{GPU_STAGING_BATCH_SIZE_ENV} must be from 1 to "
+            f"{MAX_GPU_STAGING_BATCH_SIZE}, got {batch_size}"
+        )
+    return batch_size
diff --color -ruN a/tests/v1/distributed/test_fs_native_capacity.py b/tests/v1/distributed/test_fs_native_capacity.py
--- a/tests/v1/distributed/test_fs_native_capacity.py	1970-01-01 01:00:00
+++ b/tests/v1/distributed/test_fs_native_capacity.py	2026-08-15 17:48:41
@@ -0,0 +1,219 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU-only hard-cap tests for the native filesystem connector."""
+
+# Standard
+from pathlib import Path
+from typing import Protocol
+import select
+import time
+
+# Third Party
+import pytest
+
+lmcache_fs = pytest.importorskip("lmcache.lmcache_fs")
+
+Completion = tuple[int, bool, str, list[bool] | None]
+
+
+class _FSClient(Protocol):
+    """Structural type exposed by the native filesystem pybind module."""
+
+    def event_fd(self) -> int: ...
+
+    def submit_batch_set(
+        self, keys: list[str], memoryviews: list[memoryview]
+    ) -> int: ...
+
+    def submit_batch_get(
+        self, keys: list[str], memoryviews: list[memoryview]
+    ) -> int: ...
+
+    def submit_batch_exists(self, keys: list[str]) -> int: ...
+
+    def get_current_size_bytes(self) -> int: ...
+
+    def release_keys(self, keys: list[str]) -> None: ...
+
+    def submit_batch_delete(self, keys: list[str]) -> int: ...
+
+    def drain_completions(self) -> list[Completion]: ...
+
+    def close(self) -> None: ...
+
+
+def _wait_for_completion(client: _FSClient, future_id: int) -> Completion:
+    """Wait for and return one native connector completion."""
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline:
+        readable, _, _ = select.select(
+            [client.event_fd()], [], [], max(0, deadline - time.monotonic())
+        )
+        if not readable:
+            break
+        for completion in client.drain_completions():
+            if completion[0] == future_id:
+                return completion
+    raise TimeoutError(f"native completion {future_id} did not arrive")
+
+
+def _wait_for_completions(
+    client: _FSClient, future_ids: set[int]
+) -> dict[int, Completion]:
+    """Wait for several concurrent futures without dropping early results."""
+    pending = set(future_ids)
+    results: dict[int, Completion] = {}
+    deadline = time.monotonic() + 5
+    while pending and time.monotonic() < deadline:
+        readable, _, _ = select.select(
+            [client.event_fd()], [], [], max(0, deadline - time.monotonic())
+        )
+        if not readable:
+            break
+        for completion in client.drain_completions():
+            future_id = completion[0]
+            if future_id in pending:
+                pending.remove(future_id)
+                results[future_id] = completion
+    if pending:
+        raise TimeoutError(f"native completions {sorted(pending)} did not arrive")
+    return results
+
+
+def _store(client: _FSClient, key: str, payload: bytearray) -> Completion:
+    """Submit one SET and return its completion while retaining the buffer."""
+    future_id = client.submit_batch_set([key], [memoryview(payload)])
+    return _wait_for_completion(client, future_id)
+
+
+def _connector_files(path: Path) -> list[Path]:
+    """Return final data files created by the filesystem connector."""
+    return list(path.rglob("*.data"))
+
+
+def test_capacity_rejects_concurrent_overshoot(tmp_path: Path) -> None:
+    """Concurrent worker reservations must never put more than the cap on disk."""
+    client = lmcache_fs.LMCacheFSClient(str(tmp_path), 3, "", False, 0, 10)
+    payloads = [bytearray(b"abcdef") for _ in range(3)]
+    try:
+        future_id = client.submit_batch_set(
+            ["model@00000000@0@01", "model@00000000@0@02", "model@00000000@0@03"],
+            [memoryview(payload) for payload in payloads],
+        )
+        completion = _wait_for_completion(client, future_id)
+        assert completion[1] is False
+        assert "capacity exceeded" in completion[2]
+        assert sum(path.stat().st_size for path in _connector_files(tmp_path)) <= 10
+    finally:
+        client.close()
+
+
+def test_capacity_counts_restart_files_and_reuses_deleted_space(
+    tmp_path: Path,
+) -> None:
+    """Persisted files consume capacity; a successful delete releases it."""
+    first_key = "model@00000000@0@01"
+    second_key = "model@00000000@0@02"
+    client = lmcache_fs.LMCacheFSClient(str(tmp_path), 1, "", False, 0, 10)
+    try:
+        assert _store(client, first_key, bytearray(b"12345678"))[1] is True
+    finally:
+        client.close()
+
+    restarted = lmcache_fs.LMCacheFSClient(str(tmp_path), 1, "", False, 0, 10)
+    try:
+        rejected = _store(restarted, second_key, bytearray(b"1234"))
+        assert rejected[1] is False
+        assert "current=8, requested=4, max=10" in rejected[2]
+
+        delete_id = restarted.submit_batch_delete([first_key])
+        deleted = _wait_for_completion(restarted, delete_id)
+        assert deleted[1] is True
+        assert deleted[3] == [True]
+
+        assert _store(restarted, second_key, bytearray(b"1234"))[1] is True
+        assert sum(path.stat().st_size for path in _connector_files(tmp_path)) == 4
+    finally:
+        restarted.close()
+
+
+def _lookup(client: _FSClient, keys: list[str]) -> list[bool]:
+    """Return native existence results and update their LRU recency."""
+    completion = _wait_for_completion(client, client.submit_batch_exists(keys))
+    assert completion[1] is True
+    assert completion[3] is not None
+    return completion[3]
+
+
+def test_watermark_lru_evicts_to_target_and_preserves_recent_key(
+    tmp_path: Path,
+) -> None:
+    """Crossing 80% evicts oldest files until post-store usage is 60%."""
+    client = lmcache_fs.LMCacheFSClient(
+        str(tmp_path), 2, "", False, 0, 100, 0.8, 0.2
+    )
+    keys = [
+        "model@00000000@0@a1",
+        "model@00000000@0@b2",
+        "model@00000000@0@c3",
+    ]
+    payload = bytearray(b"x" * 30)
+    try:
+        assert _store(client, keys[0], payload)[1] is True
+        assert _store(client, keys[1], payload)[1] is True
+        assert _lookup(client, [keys[0]]) == [True]
+        client.release_keys([keys[0]])
+
+        assert _store(client, keys[2], payload)[1] is True
+        assert _lookup(client, keys) == [True, False, True]
+        assert client.get_current_size_bytes() == 60
+    finally:
+        client.close()
+
+
+def test_watermark_lru_accounts_and_evicts_orphan_tmp(tmp_path: Path) -> None:
+    """Abandoned temp bytes participate in both trigger and victim selection."""
+    orphan = tmp_path / "abandoned.tmp"
+    orphan.write_bytes(b"o" * 50)
+    client = lmcache_fs.LMCacheFSClient(
+        str(tmp_path), 2, "", False, 0, 100, 0.8, 0.2
+    )
+    try:
+        key = "model@00000000@0@d4"
+        assert _store(client, key, bytearray(b"n" * 40))[1] is True
+        assert not orphan.exists()
+        assert client.get_current_size_bytes() == 40
+        assert _lookup(client, [key]) == [True]
+    finally:
+        client.close()
+
+
+def test_concurrent_retrieve_and_eviction_never_returns_partial_data(
+    tmp_path: Path,
+) -> None:
+    """An active read is pinned while a store performs native eviction."""
+    client = lmcache_fs.LMCacheFSClient(
+        str(tmp_path), 3, "", False, 0, 100, 0.8, 0.2
+    )
+    first = "model@00000000@0@e5"
+    second = "model@00000000@0@f6"
+    third = "model@00000000@0@a7"
+    first_payload = bytearray(b"r" * 40)
+    try:
+        assert _store(client, first, first_payload)[1] is True
+        assert _store(client, second, bytearray(b"s" * 30))[1] is True
+        assert _lookup(client, [first]) == [True]
+
+        destination = bytearray(40)
+        third_payload = bytearray(b"t" * 20)
+        get_id = client.submit_batch_get([first], [memoryview(destination)])
+        set_id = client.submit_batch_set([third], [memoryview(third_payload)])
+        completions = _wait_for_completions(client, {get_id, set_id})
+        get_completion = completions[get_id]
+        set_completion = completions[set_id]
+        assert get_completion[3] == [True]
+        assert set_completion[1] is True
+        assert destination == first_payload
+        assert client.get_current_size_bytes() <= 60
+        client.release_keys([first])
+    finally:
+        client.close()
