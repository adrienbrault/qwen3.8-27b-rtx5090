+
+bool FSConnector::remove_accounted_file_locked(
+    const std::filesystem::path& path) {
+  const std::string path_string = path.string();
+  if (pending_files_.find(path_string) != pending_files_.end() ||
+      pinned_files_.find(path_string) != pinned_files_.end()) {
+    return false;
+  }
+  auto record = file_records_.find(path_string);
+  std::error_code ec;
+  const bool removed = std::filesystem::remove(path, ec);
+  if (ec) {
+    throw std::runtime_error("remove failed: " + path_string + ": " +
+                             ec.message());
+  }
+  if (record != file_records_.end()) {
+    const size_t size = record->second.size_bytes;
+    current_size_bytes_ =
+        size > current_size_bytes_ ? 0 : current_size_bytes_ - size;
+    file_records_.erase(record);
+  }
+  return removed;
+}
+
+void FSConnector::evict_for_reservation_locked(size_t incoming_bytes) {
+  if (max_capacity_bytes_ == 0 || trigger_watermark_ <= 0.0) return;
+  const size_t trigger_bytes = static_cast<size_t>(
+      static_cast<double>(max_capacity_bytes_) * trigger_watermark_);
+  const size_t projected =
+      incoming_bytes > SIZE_MAX - current_size_bytes_
+          ? SIZE_MAX
+          : current_size_bytes_ + incoming_bytes;
+  if (projected < trigger_bytes) return;
+
+  const double target_fraction =
+      std::max(0.0, trigger_watermark_ - eviction_ratio_);
+  const size_t target_after_reservation = static_cast<size_t>(
+      static_cast<double>(max_capacity_bytes_) * target_fraction);
+  const size_t target_existing = target_after_reservation > incoming_bytes
+                                     ? target_after_reservation - incoming_bytes
+                                     : 0;
+  while (current_size_bytes_ > target_existing) {
+    auto victim = file_records_.end();
+    for (auto it = file_records_.begin(); it != file_records_.end(); ++it) {
+      if (pending_files_.find(it->first) != pending_files_.end() ||
+          pinned_files_.find(it->first) != pinned_files_.end()) {
+        continue;
+      }
+      if (victim == file_records_.end() ||
+          it->second.last_access < victim->second.last_access) {
+        victim = it;
+      }
+    }
+    if (victim == file_records_.end()) break;
+    const std::filesystem::path victim_path(victim->first);
+    remove_accounted_file_locked(victim_path);
+  }
+}
