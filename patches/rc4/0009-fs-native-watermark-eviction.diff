+def _wait_for_completions(
+    client: _FSClient, future_ids: set[int]
+) -> dict[int, Completion]:
+    """Wait for several concurrent futures without dropping early results."""
+    pending = set(future_ids)
+    results: dict[int, Completion] = {}
+    deadline = time.monotonic() + 5
+    while pending and time.monotonic() < deadline:
+        readable, _, _ = select.select(
+            [client.event_fd()], [], [], max(0, deadline - time.monotonic())
+        )
+        if not readable:
+            break
+        for completion in client.drain_completions():
+            future_id = completion[0]
+            if future_id in pending:
+                pending.remove(future_id)
+                results[future_id] = completion
+    if pending:
+        raise TimeoutError(f"native completions {sorted(pending)} did not arrive")
+    return results
+
