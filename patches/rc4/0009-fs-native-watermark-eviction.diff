+    )
+    try:
+        key = "model@00000000@0@d4"
+        assert _store(client, key, bytearray(b"n" * 40))[1] is True
+        assert not orphan.exists()
+        assert client.get_current_size_bytes() == 40
+        assert _lookup(client, [key]) == [True]
+    finally:
+        client.close()
+
