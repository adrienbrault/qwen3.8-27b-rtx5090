+def test_concurrent_retrieve_and_eviction_never_returns_partial_data(
+    tmp_path: Path,
+) -> None:
+    """An active read is pinned while a store performs native eviction."""
+    client = lmcache_fs.LMCacheFSClient(
+        str(tmp_path), 3, "", False, 0, 100, 0.8, 0.2
+    )
+    first = "model@00000000@0@e5"
+    second = "model@00000000@0@f6"
+    third = "model@00000000@0@a7"
+    first_payload = bytearray(b"r" * 40)
+    try:
+        assert _store(client, first, first_payload)[1] is True
+        assert _store(client, second, bytearray(b"s" * 30))[1] is True
+        assert _lookup(client, [first]) == [True]
+
+        destination = bytearray(40)
+        third_payload = bytearray(b"t" * 20)
+        get_id = client.submit_batch_get([first], [memoryview(destination)])
+        set_id = client.submit_batch_set([third], [memoryview(third_payload)])
+        completions = _wait_for_completions(client, {get_id, set_id})
+        get_completion = completions[get_id]
+        set_completion = completions[set_id]
+        assert get_completion[3] == [True]
+        assert set_completion[1] is True
+        assert destination == first_payload
+        assert client.get_current_size_bytes() <= 60
+        client.release_keys([first])
+    finally:
+        client.close()
