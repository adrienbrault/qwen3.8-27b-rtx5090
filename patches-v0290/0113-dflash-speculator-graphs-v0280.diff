@@ -122,6 +124,26 @@
 class DFlash2Speculator(DFlashSpeculator):
     _speculator_name = "DFlash2"
 
+    @property
+    def attn_vllm_config(self) -> VllmConfig:
+        config = super().attn_vllm_config
+        cache_config = config.cache_config
+        # DFlash captures its query forward in a FULL graph independently of
+        # the engine's PIECEWISE mode. Make the FlashInfer metadata builder
+        # allocate the fixed-address non-causal wrapper pool added by 0109.
+        if (
+            self.requires_non_causal
+            and cache_config is not None
+            and str(cache_config.cache_dtype).startswith("nvfp4")
+            and current_platform.is_device_capability_family(120)
+            and config.compilation_config.cudagraph_mode == CUDAGraphMode.PIECEWISE
+        ):
+            config.compilation_config = copy.copy(config.compilation_config)
+            config.compilation_config.cudagraph_mode = (
+                CUDAGraphMode.FULL_DECODE_ONLY
+            )
+        return config
+
     def __init__(self, vllm_config: VllmConfig, device: torch.device):
         super().__init__(vllm_config, device)
         draft_config = self.draft_model_config.hf_config.dflash_config
