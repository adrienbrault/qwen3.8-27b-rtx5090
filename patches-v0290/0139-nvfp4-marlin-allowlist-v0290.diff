--- a/vllm/nvfp4_marlin_allowlist.py
+++ b/vllm/nvfp4_marlin_allowlist.py
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Dependency-free parsing and matching for compressed-tensors NVFP4 opt-in."""
+
+import re
+from functools import lru_cache
+
+
+@lru_cache(maxsize=8)
+def parse_allowlist(value: str | None) -> re.Pattern[str] | None:
+    if not value:
+        return None
+    try:
+        return re.compile(value)
+    except re.error as exc:
+        raise ValueError(
+            f"Invalid VLLM_SM12X_NVFP4_MARLIN_LAYERS regex {value!r}: {exc}"
+        ) from exc
+
+
+def matches_allowlist(pattern: re.Pattern[str] | None, layer_name: str | None) -> bool:
+    return pattern is not None and layer_name is not None and bool(
+        pattern.search(layer_name)
+    )
