+# SPDX-License-Identifier: Apache-2.0
+"""One shared weight layout, static-shape Python dispatch (no device decisions)."""
+import vllm.envs as envs
+from vllm.logger import init_logger
+from vllm.nvfp4_dispatch_table import SHARED, buckets, module_rules, read_table
+from vllm.platforms import current_platform
+
+logger = init_logger(__name__)
+_affected = {}
+
+
+def wrap_kernel(default, layer_name, use_a16):
+    path = envs.VLLM_SM12X_NVFP4_DISPATCH_TABLE
+    if path is None:
+        return default
+    rules = read_table(path)
+    from vllm.model_executor.kernels import linear
+
+    if not current_platform.is_device_capability_family(120):
+        raise ValueError("NVFP4 dispatch requires SM12x")
+    if envs.VLLM_BATCH_INVARIANT or linear._get_linear_backend() != "auto":
+        raise ValueError("NVFP4 dispatch requires auto backend and no batch invariant")
+    if getattr(envs, "VLLM_SM12X_NVFP4_MARLIN_LAYERS", None) is not None:
+        raise ValueError("NVFP4 dispatch conflicts with the 0139 Marlin allowlist")
+    matched = module_rules(rules, layer_name)
+    if not matched:
+        return default
+    if use_a16:
+        raise ValueError(f"NVFP4 dispatch does not support W4A16: {layer_name}")
+    names = {name for _, name in matched} | {type(default).__name__}
+    if not names.issubset(SHARED):
+        raise ValueError(f"NVFP4 dispatch requires shared layout, got {names}")
+    kernels = {type(default).__name__: default}
+    for name in sorted(names):
+        cls = getattr(linear, name)
+        if name in envs.VLLM_DISABLED_KERNELS:
+            raise ValueError(f"NVFP4 dispatch kernel disabled: {name}")
+        for ok, reason in (cls.is_supported(), cls.can_implement(default.config)):
+            if not ok:
+                raise ValueError(f"NVFP4 dispatch {layer_name}: {name}: {reason}")
+        if name not in kernels:
+            kernels[name] = cls(default.config)
+    table = buckets(matched, type(default).__name__)
+    _affected[layer_name] = names
+    logger.debug("NVFP4 dispatch module %s: %s", layer_name, table)
+    return SharedLayoutDispatch(default, tuple((m, kernels[n]) for m, n in table))
+
+
+class SharedLayoutDispatch:
+    def __init__(self, default, table):
+        self.default = default
+        self.table = table
+
+    def input_quant_key(self):
+        # Candidate activation quantizers differ. Keep activation BF16 until apply.
+        return None
+
+    def process_weights_after_loading(self, layer):
+        # All allowed classes have identical swizzle/pad processing.
+        self.default.process_weights_after_loading(layer)
+
+    def apply_weights(self, layer, x, bias=None):
+        m = x.numel() // x.shape[-1]
+        for bound, kernel in self.table:
+            if bound is None or m <= bound:
+                return kernel.apply_weights(layer, x, bias)
+        raise AssertionError("missing unbounded NVFP4 dispatch bucket")
+
+
+def report_dispatch():
+    path = envs.VLLM_SM12X_NVFP4_DISPATCH_TABLE
+    if path is not None:
+        rules = read_table(path)
+        names = sorted(set().union(*_affected.values()))
+        logger.info_once(
+            "NVFP4 dispatch table: %d rules, %d modules affected, kernels {%s}",
+            len(rules), len(_affected), ", ".join(names), scope="process",
+        )
