--- a/vllm/nvfp4_dispatch_table.py
+++ b/vllm/nvfp4_dispatch_table.py
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Strict, dependency-free dispatch table parsing and bucket construction."""
+import json
+import re
+from functools import lru_cache
+
+SHARED = (
+    "CutlassNvFp4LinearKernel",
+    "FlashInferCutlassNvFp4LinearKernel",
+    "FlashInferB12xNvFp4LinearKernel",
+    "FlashInferCudnnNvFp4LinearKernel",
+)
+
+
+@lru_cache(maxsize=1)
+def read_table(path):
+    if not isinstance(path, str) or not path.strip():
+        raise ValueError("VLLM_SM12X_NVFP4_DISPATCH_TABLE requires a JSON file path")
+    try:
+        with open(path) as stream:
+            data = json.load(stream)
+        if not isinstance(data, dict) or set(data) != {"rules"}:
+            raise ValueError("expected exactly {'rules': [...]}")
+        if not isinstance(data["rules"], list):
+            raise ValueError("rules must be a list")
+        rules = []
+        for rule in data["rules"]:
+            if not isinstance(rule, dict) or set(rule) != {"layer", "m_max", "kernel"}:
+                raise ValueError("each rule requires layer, m_max, kernel")
+            if not isinstance(rule["layer"], str) or not rule["layer"]:
+                raise ValueError("layer must be a nonempty regex")
+            limit = rule["m_max"]
+            if limit is not None and (type(limit) is not int or limit < 1):
+                raise ValueError("m_max must be a positive integer or null")
+            if rule["kernel"] not in SHARED:
+                raise ValueError(f"unknown or non-shared-layout kernel: {rule['kernel']}")
+            rules.append((re.compile(rule["layer"]), limit, rule["kernel"]))
+        return tuple(rules)
+    except (OSError, ValueError, TypeError, re.error) as exc:
+        raise ValueError(f"Invalid NVFP4 dispatch table {path!r}: {exc}") from exc
+
+
+def module_rules(rules, name):
+    return tuple((limit, kernel) for regex, limit, kernel in rules
+                 if name is not None and regex.search(name))
+
+
+def buckets(rules, default):
+    """Inclusive upper bounds; preserve file order even for overlapping rules."""
+    limits = sorted({limit for limit, _ in rules if limit is not None})
+    result = []
+    for bound in [*limits, None]:
+        probe = bound if bound is not None else (limits[-1] + 1 if limits else 1)
+        selected = next((kernel for limit, kernel in rules
+                         if limit is None or probe <= limit), default)
+        result.append((bound, selected))
+    return tuple(result)
