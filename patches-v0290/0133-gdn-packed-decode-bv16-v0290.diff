+@functools.cache
+def _get_packed_decode_launch_config(
+    batch_size: int,
+    num_key_heads: int,
+    num_value_heads: int,
+    key_dim: int,
+    value_dim: int,
+    device_index: int,
+) -> tuple[int, int, int]:
+    tile_value_dim = min(next_power_of_2(value_dim), 32)
+    is_sm12x = current_platform.is_device_capability_family(
+        120, device_id=device_index
+    )
+    forced_bv = envs.VLLM_SM12X_GDN_PACKED_BV
+    if forced_bv is not None and is_sm12x and key_dim == value_dim == 128:
+        if forced_bv not in (16, 32):
+            raise ValueError(
+                "VLLM_SM12X_GDN_PACKED_BV must be unset, 16, or 32; "
+                f"got {forced_bv}"
+            )
+        tile_value_dim = forced_bv
+    elif (
+        num_key_heads == num_value_heads == 16
+        and key_dim == value_dim == 128
+        and batch_size <= 24
+        and is_sm12x
+    ):
+        tile_value_dim = 16
+    return tile_value_dim, 1, 3
