@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Host annotations only: capture ranges do not execute on graph replay."""
+from contextlib import contextmanager, nullcontext
+from contextvars import ContextVar
+
+import torch
+
+from vllm import envs
+from vllm.config import get_current_vllm_config
+from vllm.logger import init_logger
+from vllm.platforms import current_platform
+
+logger = init_logger(__name__)
+ENABLED = envs.VLLM_SM12X_COLLECTIVE_TAGS == "1"
+_phase = ContextVar("vocab_collective_phase", default=None)
+
+
+def validate_collective_tags() -> None:
+    if not ENABLED:
+        return
+    config = get_current_vllm_config()
+    parallel = config.parallel_config
+    if (not current_platform.is_cuda() or not config.use_v2_model_runner
+            or parallel.tensor_parallel_size != 2
+            or parallel.pipeline_parallel_size != 1):
+        raise ValueError(
+            "VLLM_SM12X_COLLECTIVE_TAGS=1 requires CUDA, V2 runner, TP2, PP1"
+        )
+
+
+@contextmanager
+def vocab_phase(phase: str):
+    if not ENABLED:
+        yield
+        return
+    token = _phase.set(phase)
+    try:
+        yield
+    finally:
+        _phase.reset(token)
+
+
+def vocab_range(tensor: torch.Tensor, phase: str):
+    if not ENABLED:
+        return nullcontext()
+    if not tensor.is_cuda or tensor.ndim != 2:
+        raise ValueError("vocab tags require a two-dimensional CUDA tensor")
+    logger.info_once(
+        "VLLM_SM12X_COLLECTIVE_TAGS=1 active; vocab_ag host ranges "
+        "(CUDA graph capture only, not replay)", scope="process"
+    )
+    phase = _phase.get() or phase
+    rows, cols = tensor.shape
+    name = f"vocab_ag:{phase}:{rows}x{cols}"
+    return _tagged_range(name, tensor.numel() * tensor.element_size(), tensor.dtype)
+
+
+@contextmanager
+def _tagged_range(name: str, num_bytes: int, dtype):
+    # NVTX for Nsight; record_function also exports into torch Chrome traces.
+    with torch.cuda.nvtx.range(name):
+        with torch.profiler.record_function(f"{name}:bytes={num_bytes}:dtype={dtype}"):
+            yield
