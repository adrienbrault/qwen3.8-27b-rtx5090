+# SPDX-License-Identifier: Apache-2.0
+"""Dependency-free, strict configuration for the single-token packed kernel."""
+import functools
+import re
+
+
+@functools.cache
+def parse_decode_config(raw: str) -> tuple[int, int, int, int, int, str]:
+    match = re.fullmatch(
+        r"bv=([0-9]+),bk=([0-9]+),warps=([0-9]+),stages=([0-9]+),split=([0-9]+)"
+        r"(?:,variant=(tiled|split))?", raw)
+    if match is None:
+        raise ValueError("VLLM_SM12X_GDN_DECODE_CFG: expected "
+                         "bv=N,bk=N,warps=N,stages=N,split=N[,variant=tiled|split]")
+    bv, bk, warps, stages, split = map(int, match.groups()[:5])
+    variant = match[6] or "tiled"
+    if (bv not in (8, 16, 32, 64) or bk != 128 or warps not in (1, 2, 4)
+            or stages not in (1, 2, 3) or split not in (1, 2, 4)
+            or bv // split < 8 or (variant == "tiled" and split != 1)):
+        raise ValueError("VLLM_SM12X_GDN_DECODE_CFG: require bv=8/16/32/64, "
+                         "bk=128, warps=1/2/4, stages=1/2/3, split=1/2/4, "
+                         "bv/split>=8; tiled requires split=1")
+    return bv, bk, warps, stages, split, variant
