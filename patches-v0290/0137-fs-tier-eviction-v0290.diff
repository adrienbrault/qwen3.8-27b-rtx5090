+    def _store_fits_locked(self) -> bool:
+        if (
+            self._max_capacity
+            and self._bytes_used + self._reserved_bytes > self._max_capacity
+        ):
+            return False
+        if self._min_free:
+            free_bytes = self._free_bytes_locked()
+            if free_bytes is None or free_bytes - self._reserved_bytes < self._min_free:
+                return False
+        return True
