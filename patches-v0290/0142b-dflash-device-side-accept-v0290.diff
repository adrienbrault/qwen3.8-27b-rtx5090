+def _sm12x_dflash_device_accept(name="VLLM_SM12X_DFLASH_DEVICE_ACCEPT", default="0", minimum=0):
+    value = os.environ.get(name, default)
+    if not value.isascii() or not value.isdecimal() or str(int(value)) != value:
+        raise ValueError(f"{name}: expected a canonical nonnegative integer")
+    number = int(value)
+    if number < minimum or (name == "VLLM_SM12X_DFLASH_DEVICE_ACCEPT" and number > 1):
+        raise ValueError(f"{name}: unsupported value {value}")
+    return number
 
 
