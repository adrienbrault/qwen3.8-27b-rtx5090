--- a/vllm/v1/worker/gpu/seqlens_copy.py
+++ b/vllm/v1/worker/gpu/seqlens_copy.py
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One exact copy per target batch, NOT shared with post-sampling DFlash."""
+import torch
+
+from vllm.logger import init_logger
+from vllm.utils.gpu_sync_debug import gpu_sync_allowed
+
+logger = init_logger(__name__)
+
+
+class SeqLensSnapshot:
+    def __init__(self, host, source, event):
+        self.host = host
+        self.source = source  # Keep the D2H source alive until completion.
+        self.event = event
+        self.value = None
+
+    def get(self, consumers):
+        if self.value is None:
+            with gpu_sync_allowed():
+                self.event.synchronize()
+            # Detach metadata lifetime from the reusable pinned staging buffer.
+            # Subsequent steps may overwrite staging while old metadata survives.
+            self.value = self.host.clone()
+            self.source = None
+            logger.info_once(
+                "SM12X seq_lens one-copy active: %d target seq_lens_cpu "
+                "consumers share one D2H per step; draft keeps its own copy",
+                consumers,
+            )
+        return self.value
+
+
+class SeqLensCopy:
+    def __init__(self, capacity, device):
+        self.device = device
+        self.host = torch.empty(capacity, dtype=torch.int32, device="cpu",
+                                pin_memory=True)
+        self.pending = None
+
+    def begin(self, source):
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("SM12X one-copy cannot run inside CUDA capture")
+        if (source.device != self.device or source.dtype != torch.int32
+                or source.ndim != 1 or not source.is_contiguous()
+                or source.numel() > self.host.numel()):
+            raise ValueError("SM12X one-copy: unsupported seq_lens tensor")
+        if self.pending is not None and self.pending.value is None:
+            raise RuntimeError("SM12X one-copy: previous batch was not consumed")
+        host = self.host[:source.numel()]
+        stream = torch.cuda.current_stream(self.device)
+        event = torch.cuda.Event()
+        host.copy_(source, non_blocking=True)
+        event.record(stream)
+        self.pending = SeqLensSnapshot(host, source, event)
+        return self.pending
