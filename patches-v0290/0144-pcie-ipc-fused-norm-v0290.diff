diff --color -ruN -x __pycache__ a/vllm/distributed/device_communicators/pcie_ipc_fused_norm.py b/vllm/distributed/device_communicators/pcie_ipc_fused_norm.py
--- a/vllm/distributed/device_communicators/pcie_ipc_fused_norm.py	1970-01-01 01:00:00
+++ b/vllm/distributed/device_communicators/pcie_ipc_fused_norm.py	2026-09-05 02:32:50
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: Apache-2.0
+"""R144: compiler replacement; no lazy workspace preparation in this op."""
+import torch
+from vllm.logger import init_logger
+from vllm.utils.torch_utils import direct_register_custom_op
+
+logger = init_logger(__name__)
+
+
+def fused_norm(x: torch.Tensor, residual: torch.Tensor, weight: torch.Tensor,
+               eps: float) -> tuple[torch.Tensor, torch.Tensor]:
+    from vllm.distributed import get_tp_group, tensor_model_parallel_all_reduce
+    import vllm.ir.ops
+    comm = get_tp_group().device_communicator.pcie_ipc_comm
+    if comm is None or comm.disabled:
+        raise RuntimeError("PCIe fused norm workspace unavailable")
+    ws = comm.workspace
+    if (x.dtype != torch.bfloat16 or x.ndim != 2 or x.shape[1] != 5120
+            or not x.is_contiguous() or residual.shape != x.shape
+            or residual.dtype != x.dtype or not residual.is_contiguous()
+            or weight.shape != (5120,) or not weight.is_contiguous()
+            or weight.dtype not in (torch.bfloat16, torch.float32)
+            or x.device != ws.device or residual.device != x.device
+            or weight.device != x.device):
+        raise ValueError("PCIe fused norm requires contiguous bf16 [M,5120], bf16/fp32 weight")
+    if x.numel() > ws.max_numel or x.shape[0] == 0:
+        logger.info_once("PCIe IPC fused norm: capacity fallback to unfused")
+        return vllm.ir.ops.fused_add_rms_norm(
+            tensor_model_parallel_all_reduce(x), residual, weight.float() + 1.0, eps)
+    # No CPU collective or allocation of IPC storage here. Stream ownership
+    # follows the workspace's own all_reduce policy (_check_stream: no-op while
+    # capturing; on an eager stream change, synchronize + rebind). R190e
+    # (2026-09-05 05:55 UTC): the original strict check raised "PCIe fused norm
+    # requires the workspace ownership stream" in capture_model's eager warmup
+    # forward, because vLLM's profile run and its capture warmup run on different
+    # current streams — the engine could not boot with the knob on.
+    ws._check_stream()
+    result = ws.native.fused_norm(ws._handle, x, residual, weight, eps)
+    logger.info_once("PCIe IPC fused norm ACTIVE: TP2 bf16 H5120 max_rows=320 R144")
+    return result
+
+
+def fake(x, residual, weight, eps):
+    return torch.empty_like(x), torch.empty_like(residual)
+
+
+direct_register_custom_op(op_name="pcie_ipc_fused_norm", op_func=fused_norm,
+                          mutates_args=[], fake_impl=fake)
