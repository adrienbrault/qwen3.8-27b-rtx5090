ARG BASE=vllm-qwen38:v0290rc2-nvfp4kv-revival-prs-fi0616-pcieipc
FROM ${BASE}
COPY 0142b-dflash-device-side-accept-v0290.diff /opt/prs-patches/0142b.diff
RUN --network=none set -eu; \
    SITE=$(python3 -c "import pathlib, vllm; assert vllm.__version__.startswith('0.29'); print(pathlib.Path(vllm.__file__).resolve().parent.parent)"); \
    patch -d "$SITE" -p1 --fuzz=0 --batch --forward < /opt/prs-patches/0142b.diff; \
    python3 -m py_compile "$SITE/vllm/envs.py" "$SITE/vllm/v1/worker/gpu/model_runner.py"; \
    mkdir -p /opt/prs-markers; \
    echo 'PRS-0142b-DFLASH-DEVICE-SIDE-ACCEPT-APPLIED' > /opt/prs-markers/0142b
